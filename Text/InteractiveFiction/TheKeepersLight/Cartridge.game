      "locked": true,
      "key": "lighthouse-key",
      "description": "A massive iron-bound door set into the base of the lighthouse."
    },
    {
      "id": "lamp",
      "name": "brass lamp",
      "nouns": [
        "lamp"
      ],
      "adjectives": [
        "brass",
        "hand"
      ],
      "location": "cottage",
      "portable": true,
      "switchable": true,
      "providesLight": true,
      "description": "A battered brass hand lamp, still half full of oil.",
      "initialDescription": "A brass lamp sits on the desk."
    },
    {
      "id": "logbook",
      "name": "keeper's logbook",
      "nouns": [
        "logbook",
        "book",
        "journal"
      ],
      "adjectives": [
        "keeper",
        "keepers",
        "log"
      ],
      "location": "cottage",
      "portable": true,
      "readable": true,
      "text": "The last entry is in a shaky hand: \"If the light fails, the lamp oil is in the sea chest down in the cellar. The lighthouse key I hid in the loft. Pull the panel by the desk and climb. May whoever reads this have better luck than I.\"",
      "description": "A thick logbook with a salt-stained cover.",
      "initialDescription": "A logbook lies open on the desk."
    },
    {
      "id": "chest",
      "name": "sea chest",
      "nouns": [
        "chest"
      ],
      "adjectives": [
        "sea",
        "oak"
      ],
      "location": "cellar",
      "container": true,
      "openable": true,
      "capacity": 2,
      "scenery": true,
      "description": "A heavy sea chest bound with brass."
    },
    {

      "switchable": true,
      "description": "The great lantern, with a dry reservoir and a cold wick."
    }
  ],
  "rules": [
    {
      "id": "read-logbook",
      "phase": "after",
      "on": {
        "verb": "read",
        "item": "logbook"
      },
      "once": true,
      "do": [
        {
          "score": 5
        },
        {
          "revealExit": {
            "room": "cottage",
            "direction": "up"
          }
        },
        {
          "say": "You find the panel by the desk and slide it aside. A ladder leads up into the dark."
        }
      ]
    },
    {
      "id": "take-oil",
      "phase": "after",
      "on": {
        "verb": "take",
        "item": "oil-can"
      },
      "once": true,
      "do": [
        {
          "score": 10
        }
      ]
    },
    {
      "id": "unlock-tower",
      "phase": "after",
      "on": {
        "verb": "unlock",
        "item": "tower-door"
      },
      "once": true,
      "do": [
        {
          "score": 10
        }
      ]
    },
    {
      "id": "fill-lantern",
      "phase": "after",
      "on": {
        "verb": "put",
        "item": "oil-can",
        "second": "lantern"
      },
      "do": [
        {
          "setFlag": "oiled"
        },
        {
          "say": "The oil runs down into the reservoir, and the wick darkens."
        }
      ]
    },
    {
      "id": "light-lantern",
      "phase": "instead",
      "on": {
        "verb": "turnon",
        "item": "lantern"
      },
      "if": [
        {
          "flagSet": "oiled"
        }
      ],
      "do": [
        {
          "setLit": {
            "item": "lantern"
          }
        },
        {
          "setFlag": "beacon"
        },
        {
          "score": 25
        },
        {
          "say": "The wick catches. Light blooms in the great lens, and a white beam sweeps out over the waves."
        }
      ]
    },
    {
      "id": "dry-lantern",
      "phase": "instead",
      "on": {
        "verb": "turnon",
        "item": "lantern"
      },
      "do": [
        {
          "say": "The wick is dry, and the reservoir is empty. It will not light without oil."
        }
      ]
    },
    {
      "id": "jump-gallery",
      "phase": "instead",
      "on": {
        "verb": "jump",
        "room": "gallery"
      },
      "do": [
        {
          "say": "You climb over the rail and let the wind take you."
        },
        {
          "end": "fell"
        }
      ]
    }
  ],
  "endings": [
    {
      "id": "beacon",
      "when": [
        {
          "flagSet": "beacon"
        }
      ],
      "message": "Far out in the dark, a ship's horn answers your light. The supply boat turns away from the rocks and slides safely toward the harbour.",
      "won": true
    },
    {
      "id": "fell",
      "when": [],
      "message": "The sea takes you, and the light stays dark. The supply boat is never seen again.",
      "won": false
    }
  ]
}

      "description": "A large brass key stamped with a tiny lighthouse.",
      "initialDescription": "A large brass key hangs from a nail."
    },
    {
      "id": "lantern",
      "name": "great lantern",
      "nouns": [
        "lantern",
        "light"
      ],
      "adjectives": [
        "great",
        "big",
        "lighthouse"
      ],
      "location": "lantern-room",

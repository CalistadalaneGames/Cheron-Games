{
  "format": "cheron-story/1",
  "id": "keepers-light",
  "title": "The Keeper's Light",
  "author": "Calistadalane Games",
  "intro": "The storm has been building all evening, and the lighthouse on the point has gone dark. Without its beam, the supply boat will hit the rocks tonight. You are the only one close enough to do anything about it.",
  "startRoom": "beach",
  "maxScore": 50,
  "rooms": [
    {
      "id": "beach",
      "name": "Shingle Beach",
      "description": "Grey waves hammer a beach of loose shingle. A path climbs north toward the headland, and the wind pushes you that way.",
      "exits": [
        {
          "direction": "north",
          "to": "yard"
        }
      ]
    },
    {
      "id": "yard",
      "name": "Keeper's Yard",
      "description": "A windswept yard of cracked paving. The keeper's cottage stands to the east. To the north the lighthouse rises into the clouds, its great door shut tight. The path to the beach runs south.",
      "exits": [
        {
          "direction": "south",
          "to": "beach"
        },
        {
          "direction": "east",
          "to": "cottage",
          "door": "cottage-door"
        },
        {
          "direction": "north",
          "to": "tower-foot",
          "door": "tower-door"
        }
      ]
    },
    {
      "id": "cottage",
      "name": "Keeper's Cottage",
      "description": "A cramped, cold room that smells of old smoke. A rough desk sits under the window. A trapdoor in the floor leads down. The yard is back to the west.",
      "exits": [
        {
          "direction": "west",
          "to": "yard",
          "door": "cottage-door"
        },
        {
          "direction": "down",
          "to": "cellar"
        },
        {
          "direction": "up",
          "to": "loft",
          "hidden": true
        }
      ]
    },
    {
      "id": "cellar",
      "name": "Cellar",
      "description": "Cold stone walls sweat in the lamplight. Steps lead up to the cottage. A low smugglers' tunnel slopes away toward the sea.",
      "dark": true,
      "exits": [
        {
          "direction": "up",
          "to": "cottage"
        },
        {
          "direction": "out",
          "to": "beach"
        }
      ]
    },
    {
      "id": "loft",
      "name": "Loft",
      "description": "A cramped space under the roof, hidden behind a false panel. Dust lies thick on every board. A ladder leads back down.",
      "exits": [
        {
          "direction": "down",
          "to": "cottage"
        }
      ]
    },
    {
      "id": "tower-foot",
      "name": "Foot of the Tower",
      "description": "A round stone room at the base of the lighthouse. An iron stair spirals upward into the dark. The yard lies to the south.",
      "exits": [
        {
          "direction": "south",
          "to": "yard",
          "door": "tower-door"
        },
        {
          "direction": "up",
          "to": "lantern-room"
        }
      ]
    },
    {
      "id": "lantern-room",
      "name": "Lantern Room",
      "description": "The top of the lighthouse, ringed with great panes of salt-streaked glass. In the middle stands the lantern, cold and dark. A narrow door leads east onto the gallery. The stair goes down.",
      "exits": [
        {
          "direction": "down",
          "to": "tower-foot"
        },
        {
          "direction": "east",
          "to": "gallery"
        }
      ]
    },
    {
      "id": "gallery",
      "name": "Gallery",
      "description": "An iron balcony runs around the outside of the lighthouse. The wind is fierce, and the rail is low. Far below, the sea boils white around the rocks. The lantern room is back to the west.",
      "exits": [
        {
          "direction": "west",
          "to": "lantern-room"
        }
      ]
    }
  ],
  "items": [
    {
      "id": "boat",
      "name": "rowing boat",
      "nouns": [
        "boat"
      ],
      "adjectives": [
        "rowing"
      ],
      "location": "beach",
      "scenery": true,
      "description": "A rowing boat, dragged high on the shingle and stove in. It will not be going anywhere."
    },
    {
      "id": "rusty-key",
      "name": "rusty key",
      "nouns": [
        "key"
      ],
      "adjectives": [
        "rusty",
        "small"
      ],
      "location": "beach",
      "portable": true,
      "description": "A small iron key, thick with rust.",
      "initialDescription": "Something small and rusty is caught between the stones."
    },
    {
      "id": "cottage-door",
      "name": "cottage door",
      "nouns": [
        "door"
      ],
      "adjectives": [
        "cottage",
